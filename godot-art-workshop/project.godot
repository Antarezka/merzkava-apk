; Merzkava Godot Art Workshop — isolated visual prototype, not the APK runtime.
config_version=5

[application]
config/name="Merzkava Godot Art Workshop"
run/main_scene="res://scenes/art_preview.tscn"

[display]
window/size/viewport_width=720
window/size/viewport_height=400
window/size/window_width_override=1080
window/size/window_height_override=600
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
