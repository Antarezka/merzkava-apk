; Merzkava native Godot client — portrait-only migration foundation.
; Keep this file pinned to the stable engine version used by cloud CI.
; Portrait is locked in both project settings and the Android export manifest. Landscape is not supported.

config_version=5

[application]

config/name="Merzkava"
config/description="Merzkava Universe · native Android client"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0470588, 0.054902, 0.0666667, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[rendering]
