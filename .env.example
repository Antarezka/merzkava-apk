# Public app configuration (safe to include in the client build)
# Supabase anon key is a public client key; never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_GM_GATEWAY_URL=https://YOUR_WORKER.YOUR_SUBDOMAIN.workers.dev
